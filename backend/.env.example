# Magπ Server Configuration
PORT=5001

# MongoDB Connection String (MongoDB Atlas Free Tier or Local MongoDB)
# Example for MongoDB Atlas Free Tier:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/magpi?retryWrites=true&w=majority
#
# If left empty, the server automatically uses local persistent storage (backend/data/bookings.json)
MONGODB_URI=
